                                                >
                                                  {isCourseLocked && <Lock className="w-2.5 h-2.5 sm:w-3.5 sm:h-3.5 text-white/90 shrink-0" />}
                                                  <span className="sm:hidden truncate">à¦²à¦¾à¦‡à¦­ à¦ªà¦°à§€à¦•à§�à¦·à¦¾</span>
                                                  <span className="hidden sm:inline truncate">à¦²à¦¾à¦‡à¦­ à¦ªà¦°à§€à¦•à§�à¦·à¦¾ à¦¦à¦¿à¦¨</span>
                                                </button>
