    setSelectedBookmarkQId(null);
    showCustomAlert('ðŸ”– à¦ªà§�à¦°à¦¶à§�à¦¨à¦Ÿà¦¿ à¦¬à§�à¦•à¦®à¦¾à¦°à§�à¦• à¦•à¦¾à¦²à§‡à¦•à¦¶à¦¨à§‡ à¦¯à§‹à¦— à¦•à¦°à¦¾ à¦¹à§Ÿà§‡à¦›à§‡!');
  };

  const handleOpenReaderMode = async (type: 'prep' | 'job', customValue?: string, overrideQuestions?: Question[]) => {
    if (!checkGuestAccess('MCQ à¦ªà§œà¦¾ à¦“ à¦¸à¦®à¦¾à¦§à¦¾à¦¨ à¦­à¦¿à¦‰')) return;
    let filtered: Question[] = [];
    const targetValue = customValue || (type === 'prep' ? prepCategory : jobSubcategory);
    
    if (overrideQuestions) {
      filtered = overrideQuestions;
      setReaderTitle(type === 'prep' ? `à¦¬à¦¿à¦·à§Ÿà¦­à¦¿à¦¤à§�à¦¤à¦¿à¦• à¦ªà§œà¦¾: ${targetValue}` : `à¦œà¦¬ à¦¸à¦²à¦¿à¦‰à¦¶à¦¨ à¦°à¦¿à¦¡à¦¾à¦°: ${targetValue}`);
    } else {
      if (type === 'prep') {
        filtered = questions.filter(q => 
          q.category === targetValue || (q.categories && q.categories.includes(targetValue))
        );
        if (onFetchQuestionsLazy) {
          const fetched = await onFetchQuestionsLazy({ category: targetValue });
          if (fetched && fetched.length > 0) {
            const fetchedFiltered = fetched.filter(q => q.category === targetValue || (q.categories && q.categories.includes(targetValue)));
            if (fetchedFiltered.length > 0) {
              const map = new Map<string, Question>();
              filtered.forEach(q => map.set(String(q.id), q));
              fetchedFiltered.forEach(q => map.set(String(q.id), q));
              filtered = Array.from(map.values());
            }
          }
        }
        setReaderTitle(`à¦¬à¦¿à¦·à§Ÿà¦­à¦¿à¦¤à§�à¦¤à¦¿à¦• à¦ªà§œà¦¾: ${targetValue}`);
        if (customValue) setPrepCategory(customValue);
      } else {
        filtered = questions.filter(q => 
          q.subcategory === targetValue || (q.subcategories && q.subcategories.includes(targetValue))
        );
        if (onFetchQuestionsLazy) {
          const fetched = await onFetchQuestionsLazy({ subcategory: targetValue });
          if (fetched && fetched.length > 0) {
            const fetchedFiltered = fetched.filter(q => q.subcategory === targetValue || (q.subcategories && q.subcategories.includes(targetValue)));
            if (fetchedFiltered.length > 0) {
              const map = new Map<string, Question>();
              filtered.forEach(q => map.set(String(q.id), q));
              fetchedFiltered.forEach(q => map.set(String(q.id), q));
              filtered = Array.from(map.values());
            }
          }
        }
        setReaderTitle(`à¦œà¦¬ à¦¸à¦²à¦¿à¦‰à¦¶à¦¨ à¦°à¦¿à¦¡à¦¾à¦°: ${targetValue}`);
        if (customValue) setJobSubcategory(customValue);
      }
    }

    if (filtered.length === 0) {
      showCustomAlert('à¦ªà§œà¦¾à¦° à¦œà¦¨à§�à¦¯ à¦•à§‹à¦¨à§‹ à¦ªà§�à¦°à¦¶à§�à¦¨ à¦ªà¦¾à¦“à§Ÿà¦¾ à¦¯à¦¾à§Ÿà¦¨à¦¿!');
      return;
    }
    setReaderSelectedAnswers({});
    setReaderPage(1);
    setReaderQuestions(filtered);
    setReaderSource(type);
    setReaderCategoryFilter('à¦¸à¦¬ à¦ªà§�à¦°à¦¶à§�à¦¨');
    setReaderModeActive(true);
  };

