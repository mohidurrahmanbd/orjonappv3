                  }`}
                >
                  ðŸ“– à¦ªà§œà¦¾
                </button>
                <button
                  onClick={() => setReaderActiveMode('verify')}
                  className={`px-3 py-1.5 rounded-lg text-center transition flex items-center gap-1 whitespace-nowrap ${
                    readerActiveMode === 'verify' 
                      ? 'bg-purple-600 text-white shadow-sm' 
                      : 'text-gray-600 hover:text-purple-600 hover:bg-white/40'
                  }`}
                >
                  âœ�ï¸� à¦¯à¦¾à¦šà¦¾à¦‡
                </button>
                <button
                  onClick={() => {
                    const cleanedTitle = readerTitle
                      .replace('à¦…à¦§à§�à¦¯à¦¾à§Ÿà¦­à¦¿à¦¤à§�à¦¤à¦¿à¦• à¦…à¦¨à§�à¦¶à§€à¦²à¦¨: ', '')
                      .replace('à¦ªà¦°à§€à¦•à§�à¦·à¦¾à¦­à¦¿à¦¤à§�à¦¤à¦¿à¦• à¦…à¦¨à§�à¦¶à§€à¦²à¦¨: ', '')
                      .replace('à¦¬à¦¿à¦·à§Ÿà¦­à¦¿à¦¤à§�à¦¤à¦¿à¦• à¦…à¦¨à§�à¦¶à§€à¦²à¦¨: ', '');
                    
                    const poolToUse = readerCategoryFilter === 'à¦¸à¦¬ à¦ªà§�à¦°à¦¶à§�à¦¨' 
                      ? readerQuestions 
