                  <div 
                    className="shrink-0"
                    title={`à¦ªà§œà¦¾à¦° à¦…à¦—à§�à¦°à¦—à¦¤à¦¿: ${toBengaliDigits(exam.progress.readCount)}/${toBengaliDigits(exam.progress.totalCount)} (${toBengaliDigits(exam.progress.percentage)}%)`}
                  >
                    <CircularProgressBar
                      percentage={exam.progress.percentage}
                      size={26}
                      strokeWidth={2.5}
                      textSizeClass="text-[7.5px]"
                    />
                  </div>
