rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && (
        request.auth.uid == userId ||
        (resource != null && resource.data.email == request.auth.token.email) ||
        (resource != null && resource.data.userId == request.auth.uid)
      );
    }

    function isWriteOwner(userId) {
      return isSignedIn() && (
        request.auth.uid == userId ||
        (request.resource.data.email == request.auth.token.email) ||
        (request.resource.data.userId == request.auth.uid)
      );
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.admin == true;
    }

    // Questions collection - Read-only for users, Admin-write only
    match /questions/{questionId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Users collection - Users can read/write only their own document, Admins can access all
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isWriteOwner(userId) || isAdmin();
      allow update: if isOwner(userId) || isWriteOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    // Bookmarks collection - Users can manage only their bookmarks, Admins can access all
    match /bookmarks/{bookmarkId} {
      allow read, write: if isSignedIn() && (
        resource == null ||
        resource.data.userUid == request.auth.uid ||
        resource.data.userEmail == request.auth.token.email ||
        isAdmin()
      );
    }

    // Attempts collection - Users can read/write only their own documents, Admins can access all
    match /attempts/{attemptId} {
      allow read: if isSignedIn() && (
        resource == null ||
        resource.data.userId == request.auth.uid ||
        resource.data.userEmail == request.auth.token.email ||
        isAdmin()
      );
      allow create: if isSignedIn() && (
        request.resource.data.userId == request.auth.uid ||
        request.resource.data.userEmail == request.auth.token.email ||
        isAdmin()
      );
      allow update, delete: if isAdmin();
    }

    // Categories collection - Read-only for users, Admin-write only
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Subcategories collection - Read-only for users, Admin-write only
    match /subcategories/{subcategoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Notices collection - Read-only for users, Admin-write only
    match /notices/{noticeId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Routines collection - Read-only for users, Admin-write only
    match /routines/{routineId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Courses collection - Read-only for users, Admin-write only
    match /courses/{courseId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Course Enrollments collection - Users can read/create only their own enrollments, Admins can access all
    match /course_enrollments/{enrollmentId} {
      allow read: if isSignedIn() && (
        resource == null ||
        resource.data.userId == request.auth.uid ||
        resource.data.userEmail == request.auth.token.email ||
        isAdmin()
      );
      allow create: if isSignedIn() && (
        request.resource.data.userId == request.auth.uid ||
        request.resource.data.userEmail == request.auth.token.email ||
        isAdmin()
      );
      allow update, delete: if isAdmin();
    }

    // Live Exams collection - Read-only for users, Admin-write only
    match /live_exams/{liveExamId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Coupons collection - Read-only for users, Admin-write only
    match /coupons/{couponId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Payment settings collection - Read-only for users, Admin-write only
    match /payment_settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Audit Logs collection - Admin only
    match /audit_logs/{logId} {
      allow read, write: if isAdmin();
    }

    // Upload History collection - Admin only
    match /upload_history/{uploadId} {
      allow read, write: if isAdmin();
    }

    // Test connection collection
    match /test/{testId} {
      allow read, write: if isAdmin();
    }

    // Meta collection (versioning and system metadata)
    match /meta/{metaId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Default deny for unhandled paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
