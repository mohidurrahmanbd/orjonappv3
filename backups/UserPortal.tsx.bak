                </button>
                <p className="text-[9px] text-center text-slate-400 font-medium">à¦…à¦°à§�à¦œà¦¨ à¦ªà§‹à¦°à§�à¦Ÿà¦¾à¦² Â© {new Date().getFullYear()}</p>
