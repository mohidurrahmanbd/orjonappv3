  if (norm.includes('à¦¬à§�à¦¯à¦¾à¦‚à¦•') || norm.includes('bank') || norm.includes('à¦…à¦°à§�à¦¥à¦¨à§€à¦¤à¦¿') || norm.includes('finance')) {
