                    <Calendar className="w-8 h-8 text-slate-300" />
                    <span className="font-extrabold text-xs text-slate-700">
                      {yearJobSearchQuery ? `"${yearJobSearchQuery}" à¦�à¦° à¦¸à¦¾à¦¥à§‡ à¦®à¦¿à¦²à§‡ à¦�à¦®à¦¨ à¦•à§‹à¦¨à§‹ à¦ªà¦°à§€à¦•à§�à¦·à¦¾ à¦ªà¦¾à¦“à§Ÿà¦¾ à¦¯à¦¾à§Ÿà¦¨à¦¿à¥¤` : 'à¦œà¦¬ à¦¸à¦²à¦¿à¦‰à¦¶à¦¨ à¦¬à§�à¦¯à¦¾à¦‚à¦•à§‡ à¦�à¦–à¦¨à§‹ à¦•à§‹à¦¨à§‹ à¦ªà¦°à§€à¦•à§�à¦·à¦¾ à¦¯à§�à¦•à§�à¦¤ à¦•à¦°à¦¾ à¦¹à§Ÿà¦¨à¦¿à¥¤'}
                    </span>
                    <span className="text-[11px] text-slate-400 max-w-sm">
                      à¦œà¦¬ à¦¸à¦²à¦¿à¦‰à¦¶à¦¨ à¦¬à§�à¦¯à¦¾à¦‚à¦•à§‡ à¦¨à¦¤à§�à¦¨ à¦ªà¦°à§€à¦•à§�à¦·à¦¾ à¦¤à§ˆà¦°à¦¿ à¦•à¦°à¦¾ à¦¹à¦²à§‡ à¦¤à¦¾ à¦¸à§�à¦¬à§Ÿà¦‚à¦•à§�à¦°à¦¿à§Ÿà¦­à¦¾à¦¬à§‡ à¦¤à¦¾à¦° à¦ªà¦°à§€à¦•à§�à¦·à¦¾à¦° à¦¸à¦¾à¦² à¦“ à¦®à¦¾à¦¸ à¦…à¦¨à§�à¦¯à¦¾à§Ÿà§€ à¦�à¦–à¦¾à¦¨à§‡ à¦ªà§�à¦°à¦¦à¦°à§�à¦¶à¦¿à¦¤ à¦¹à¦¬à§‡à¥¤
                    </span>
                  </div>
                ) : (
                  <div className="flex flex-col gap-2.5">
                    {filteredYears.map(yearGroup => {
                      const isYearExpanded = query ? true : expandedYearKeys.has(yearGroup.year);

                      return (
                        <div 
