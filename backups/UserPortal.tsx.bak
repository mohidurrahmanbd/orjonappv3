                      <span>à¦ªà§�à¦°à¦¸à§�à¦¤à§�à¦¤à¦¿ à¦¹à§‹à¦®</span>
                    </button>
                    {prepPath.map((pathItem, index) => {
                      const isLast = index === prepPath.length - 1;
                      return (
                        <React.Fragment key={`prep-path-${pathItem}-${index}`}>
                          <ChevronRight className="w-3 h-3 text-gray-400" />
                          {isLast ? (
