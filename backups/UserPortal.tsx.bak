                                      title={`MCQ à¦ªà§œà¦¾à¦° à¦…à¦—à§�à¦°à¦—à¦¤à¦¿: ${toBengaliDigits(readingProgress.percentage)}% à¦¸à¦®à§�à¦ªà¦¨à§�à¦¨`}
                                    >
                                      <CircularProgressBar 
                                        percentage={readingProgress.percentage} 
                                        size={28} 
                                        strokeWidth={3}
                                        textSizeClass="text-[8px]"
                                      />
