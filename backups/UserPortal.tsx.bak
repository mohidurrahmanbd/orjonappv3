                onClick={() => {
                  showCustomConfirm(
                    `à¦†à¦ªà¦¨à¦¿ à¦•à¦¿ à¦�à¦‡ à¦ªà¦°à§€à¦•à§�à¦·à¦¾à¦Ÿà¦¿ à¦¸à¦®à¦¾à¦ªà§�à¦¤ à¦•à¦°à¦¤à§‡ à¦šà¦¾à¦¨?\n\nâ€¢ à¦®à§‹à¦Ÿ à¦ªà§�à¦°à¦¶à§�à¦¨: ${toBengaliDigits(quizQuestions.length)}à¦Ÿà¦¿\nâ€¢ à¦‰à¦¤à§�à¦¤à¦° à¦¦à¦¿à§Ÿà§‡à¦›à§‡à¦¨: ${toBengaliDigits(answeredExamCount)}à¦Ÿà¦¿\nâ€¢ à¦…à¦¨à§�à¦¤à§�à¦¤à¦°/à¦¬à¦¾à¦•à¦¿: ${toBengaliDigits(unansweredCount)}à¦Ÿà¦¿\n\nà¦œà¦®à¦¾ à¦¦à¦¿à¦²à§‡ à¦†à¦ªà¦¨à¦¾à¦° à¦«à¦²à¦¾à¦«à¦² à¦¤à¦¾à§Žà¦•à§�à¦·à¦£à¦¿à¦• à¦¤à§ˆà¦°à¦¿ à¦¹à¦¬à§‡à¥¤`,
