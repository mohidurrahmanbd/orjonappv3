                              <div className="flex items-center gap-2 flex-wrap min-w-0">
                                <span className="font-black text-[13px] sm:text-[14.5px] text-slate-900 leading-tight">
                                  {isYearExpanded ? 'â–¼ ' : 'â–¶ '} {yearGroup.yearLabel}
