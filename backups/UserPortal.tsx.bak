// Helper to detect if a category name is a known Subject Preparation root or subject
const isSubjectPrepRootOrSubject = (name: string): boolean => {
  if (!name) return false;
  const norm = name.trim().toLowerCase();
  return (
    norm === 'à¦¬à¦¿à¦·à§Ÿà¦­à¦¿à¦¤à§�à¦¤à¦¿à¦• à¦ªà§�à¦°à¦¸à§�à¦¤à§�à¦¤à¦¿' ||
    norm === 'à¦¬à¦¿à¦·à§Ÿ à¦­à¦¿à¦•à§�à¦¤à¦¿à¦• à¦ªà§�à¦°à¦¸à§�à¦¤à§�à¦¤à¦¿' ||
    norm === 'à¦¬à¦¿à¦·à§Ÿà¦­à¦¿à¦¤à§�à¦¤à¦¿à¦•' ||
    norm === 'à¦¬à¦¿à¦·à§Ÿ à¦­à¦¿à¦¤à§�à¦¤à¦¿à¦•' ||
    norm === 'subject' ||
    norm === 'preparation' ||
    norm === 'à¦¬à¦¾à¦‚à¦²à¦¾' ||
    norm === 'à¦¬à¦¾à¦‚à¦²à¦¾ à¦¸à¦¾à¦¹à¦¿à¦¤à§�à¦¯' ||
    norm === 'à¦¬à¦¾à¦‚à¦²à¦¾ à¦¬à§�à¦¯à¦¾à¦•à¦°à¦£' ||
    norm === 'à¦‡à¦‚à¦°à§‡à¦œà¦¿' ||
    norm === 'à¦‡à¦‚à¦°à§‡à¦œà¦¿ à¦­à¦¾à¦·à¦¾ à¦“ à¦¸à¦¾à¦¹à¦¿à¦¤à§�à¦¯' ||
    norm === 'à¦—à¦£à¦¿à¦¤' ||
    norm === 'à¦—à¦¾à¦£à¦¿à¦¤à¦¿à¦• à¦¯à§�à¦•à§�à¦¤à¦¿' ||
    norm === 'à¦®à¦¾à¦¨à¦¸à¦¿à¦• à¦¦à¦•à§�à¦·à¦¤à¦¾' ||
    norm === 'à¦¸à¦¾à¦§à¦¾à¦°à¦£ à¦œà§�à¦žà¦¾à¦¨' ||
    norm === 'à¦¬à¦¾à¦‚à¦²à¦¾à¦¦à§‡à¦¶ à¦¬à¦¿à¦·à§Ÿà¦¾à¦¬à¦²à§€' ||
    norm === 'à¦†à¦¨à§�à¦¤à¦°à§�à¦œà¦¾à¦¤à¦¿à¦• à¦¬à¦¿à¦·à§Ÿà¦¾à¦¬à¦²à§€' ||
    norm === 'à¦¸à¦¾à¦§à¦¾à¦°à¦£ à¦¬à¦¿à¦œà§�à¦žà¦¾à¦¨' ||
    norm === 'à¦¬à¦¿à¦œà§�à¦žà¦¾à¦¨' ||
    norm === 'à¦œà§€à¦¬à¦¬à¦¿à¦œà§�à¦žà¦¾à¦¨' ||
    norm === 'à¦ªà¦¦à¦¾à¦°à§�à¦¥à¦¬à¦¿à¦œà§�à¦žà¦¾à¦¨' ||
    norm === 'à¦°à¦¸à¦¾à¦¯à¦¼à¦¨' ||
    norm === 'à¦•à¦®à§�à¦ªà¦¿à¦‰à¦Ÿà¦¾à¦° à¦“ à¦¤à¦¥à§�à¦¯à¦ªà§�à¦°à¦¯à§�à¦•à§�à¦¤à¦¿' ||
    norm === 'à¦•à¦®à§�à¦ªà¦¿à¦‰à¦Ÿà¦¾à¦°' ||
    norm === 'à¦¤à¦¥à§�à¦¯à¦ªà§�à¦°à¦¯à§�à¦•à§�à¦¤à¦¿' ||
    norm === 'à¦­à§‚à¦—à§‹à¦² à¦“ à¦ªà¦°à¦¿à¦¬à§‡à¦¶' ||
    norm === 'à¦­à§‚à¦—à§‹à¦²' ||
    norm === 'à¦­à§‚à¦—à§‹à¦² (à¦¬à¦¾à¦‚à¦²à¦¾à¦¦à§‡à¦¶ à¦“ à¦¬à¦¿à¦¶à§�à¦¬)' ||
    norm === 'à¦¨à§ˆà¦¤à¦¿à¦•à¦¤à¦¾ à¦“ à¦®à§‚à¦²à§�à¦¯à¦¬à§‹à¦§' ||
    norm === 'à¦¨à§ˆà¦¤à¦¿à¦•à¦¤à¦¾ à¦“ à¦®à§�à¦²à§�à¦¯à¦¬à§‹à¦§' ||
    norm === 'à¦¨à§ˆà¦¤à¦¿à¦•à¦¤à¦¾, à¦®à§‚à¦²à§�à¦¯à¦¬à§‹à¦§ à¦“ à¦¸à§�à¦¶à¦¾à¦¸à¦¨' ||
    norm === 'à¦¸à§�à¦¶à¦¾à¦¸à¦¨'
  );
};

// Single Source of Truth: Check if a subcategory strictly belongs to "à¦œà¦¬ à¦¸à¦²à¦¿à¦‰à¦¶à¦¨ à¦¬à§�à¦¯à¦¾à¦‚à¦•" by traversing its ancestor lineage
const isSubcategoryInJobSolutionTree = (sub: SubcategoryItem, allSubcats: SubcategoryItem[]): boolean => {
  let currentParent = (sub.parentCategory || '').trim();
  const visited = new Set<string>();
  let depth = 0;

  while (currentParent && depth < 20) {
    const parentNorm = currentParent.toLowerCase();
    if (visited.has(parentNorm)) break;
    visited.add(parentNorm);
    depth++;

    // 1. Direct Subject Prep root check (Strict rejection)
    if (isSubjectPrepRootOrSubject(currentParent)) {
      return false;
    }

    // 2. Direct Job Solution root check (Acceptance)
    if (isJobSolutionVariation(currentParent) || isYearJobSolutionVariation(currentParent)) {
      return true;
    }

    // 3. Other non-job root categories (rejection)
    if (parentNorm === 'à¦®à¦¡à§‡à¦² à¦Ÿà§‡à¦¸à§�à¦Ÿ' || parentNorm === 'à¦¸à¦¾à¦®à§�à¦ªà§�à¦°à¦¤à¦¿à¦• à¦¬à¦¿à¦·à§Ÿà¦¾à¦¬à¦²à§€' || parentNorm === 'à¦¡à§‡à¦‡à¦²à¦¿ à¦�à¦•à§�à¦¸à¦¾à¦®') {
      return false;
    }

    // 4. Look up parent's parent in subcategories
    const parentObj = allSubcats.find(s => s.name && s.name.trim().toLowerCase() === parentNorm);
    if (!parentObj) {
      // Parent is not in subcategories, check if it's a job solution variation
      return isJobSolutionVariation(currentParent) || isYearJobSolutionVariation(currentParent);
    }

    currentParent = (parentObj.parentCategory || '').trim();
  }

  return false;
};

// Helper to return representative icon based on subject/category title
const renderSubjectIcon = (name: string, sizeClass = "w-4 h-4") => {
  const norm = (name || '').toLowerCase();

  if (norm.includes('à¦¬à¦¾à¦‚à¦²à¦¾') || norm.includes('bangla') || norm.includes('à¦¸à¦¾à¦¹à¦¿à¦¤à§�à¦¯') || norm.includes('à¦¬à§�à¦¯à¦¾à¦•à¦°à¦£')) {
    return <Languages className={sizeClass} />;
  }
  if (norm.includes('à¦‡à¦‚à¦°à§‡à¦œà¦¿') || norm.includes('english') || norm.includes('à¦—à§�à¦°à¦¾à¦®à¦¾à¦°') || norm.includes('grammar')) {
    return <Globe className={sizeClass} />;
  }
  if (norm.includes('à¦—à¦£à¦¿à¦¤') || norm.includes('math') || norm.includes('à¦ªà¦¾à¦Ÿà¦¿à¦—à¦£à¦¿à¦¤') || norm.includes('à¦¬à§€à¦œà¦—à¦£à¦¿à¦¤') || norm.includes('à¦œà§�à¦¯à¦¾à¦®à¦¿à¦¤à¦¿') || norm.includes('à¦…à¦™à§�à¦•')) {
    return <Calculator className={sizeClass} />;
  }
  if (norm.includes('à¦•à¦®à§�à¦ªà¦¿à¦‰à¦Ÿà¦¾à¦°') || norm.includes('ict') || norm.includes('à¦†à¦‡à¦¸à¦¿à¦Ÿà¦¿') || norm.includes('à¦¤à¦¥à§�à¦¯à¦ªà§�à¦°à¦¯à§�à¦•à§�à¦¤à¦¿') || norm.includes('à¦ªà§�à¦°à¦¯à§�à¦•à§�à¦¤à¦¿') || norm.includes('à¦•à¦®à§�à¦ªà¦¿à¦‰à¦Ÿà¦¾à¦° à¦“ à¦¤à¦¥à§�à¦¯à¦ªà§�à¦°à¦¯à§�à¦•à§�à¦¤à¦¿')) {
    return <Laptop className={sizeClass} />;
  }
  if (norm.includes('à¦¬à¦¿à¦œà§�à¦žà¦¾à¦¨') || norm.includes('science') || norm.includes('à¦ªà¦¦à¦¾à¦°à§�à¦¥') || norm.includes('à¦°à¦¸à¦¾à¦¯à¦¼à¦¨') || norm.includes('à¦œà§€à¦¬à¦¬à¦¿à¦œà§�à¦žà¦¾à¦¨') || norm.includes('à¦ªà¦¦à¦¾à¦°à§�à¦¥à¦¬à¦¿à¦œà§�à¦žà¦¾à¦¨')) {
    return <FlaskConical className={sizeClass} />;
  }
  if (norm.includes('à¦¬à¦¾à¦‚à¦²à¦¾à¦¦à§‡à¦¶') || norm.includes('bangladesh') || norm.includes('à¦¸à¦‚à¦¬à¦¿à¦§à¦¾à¦¨') || norm.includes('à¦®à§�à¦•à§�à¦¤à¦¿à¦¯à§�à¦¦à§�à¦§')) {
    return <Landmark className={sizeClass} />;
  }
  if (norm.includes('à¦†à¦¨à§�à¦¤à¦°à§�à¦œà¦¾à¦¤à¦¿à¦•') || norm.includes('international') || norm.includes('à¦¬à¦¿à¦¶à§�à¦¬')) {
    return <Globe2 className={sizeClass} />;
  }
  if (norm.includes('à¦­à§‚à¦—à§‹à¦²') || norm.includes('à¦ªà¦°à¦¿à¦¬à§‡à¦¶') || norm.includes('à¦¦à§�à¦°à§�à¦¯à§‹à¦—') || norm.includes('geography')) {
    return <Compass className={sizeClass} />;
  }
  if (norm.includes('à¦®à¦¾à¦¨à¦¸à¦¿à¦• à¦¦à¦•à§�à¦·à¦¤à¦¾') || norm.includes('à¦¬à§�à¦¦à§�à¦§à¦¿à¦®à¦¤à§�à¦¤à¦¾') || norm.includes('mental')) {
    return <BrainCircuit className={sizeClass} />;
  }
  if (norm.includes('à¦¨à§ˆà¦¤à¦¿à¦•à¦¤à¦¾') || norm.includes('à¦®à§‚à¦²à§�à¦¯à¦¬à§‹à¦§') || norm.includes('à¦¸à§�à¦¶à¦¾à¦¸à¦¨') || norm.includes('ethics')) {
    return <Scale className={sizeClass} />;
  }
  if (norm.includes('à¦¸à¦¾à¦§à¦¾à¦°à¦£ à¦œà§�à¦žà¦¾à¦¨') || norm.includes('gk') || norm.includes('à¦œà§�à¦žà¦¾à¦¨')) {
