                    { id: 'recentJob', label: 'âš¡ à¦°à¦¿à¦¸à§‡à¦¨à§�à¦Ÿ à¦œà¦¬ à¦¸à¦²à¦¿à¦‰à¦¶à¦¨', icon: Sparkles },
                    { id: 'currentAffairs', label: 'ðŸŒ� à¦¸à¦¾à¦®à§�à¦ªà§�à¦°à¦¤à¦¿à¦• à¦¬à¦¿à¦·à§Ÿà¦¾à¦¬à¦²à§€', icon: Globe },
                    { id: 'preparation', label: 'ðŸ“š à¦¬à¦¿à¦·à§Ÿà¦­à¦¿à¦¤à§�à¦¤à¦¿à¦• à¦ªà§�à¦°à¦¸à§�à¦¤à§�à¦¤à¦¿', icon: BookOpen },
                    { id: 'job', label: 'ðŸ’¼ à¦œà¦¬ à¦¸à¦²à¦¿à¦‰à¦¶à¦¨ à¦¬à§�à¦¯à¦¾à¦‚à¦•', icon: Layers },
                    { id: 'yearJob', label: 'ðŸ“… à¦¸à¦¾à¦² à¦­à¦¿à¦¤à§�à¦¤à¦¿à¦• à¦œà¦¬ à¦¸à¦²à¦¿à¦‰à¦¶à¦¨', icon: Calendar },
                    { id: 'exams', label: 'â�±ï¸� à¦�à¦•à§�à¦¸à¦¾à¦® à¦œà§‹à¦¨ (à¦ªà¦°à§€à¦•à§�à¦·à¦¾)', icon: Clock },
                    { id: 'bookmarks', label: 'ðŸ”– à¦¸à§‡à¦­à¦•à§ƒà¦¤ à¦¬à§�à¦•à¦®à¦¾à¦°à§�à¦•à¦¸', icon: BookmarkIcon },
                    { id: 'results', label: 'ðŸ“� à¦ªà¦°à§€à¦•à§�à¦·à¦¾à¦° à¦«à¦²à¦¾à¦«à¦²', icon: Award },
                    { id: 'courses', label: 'ðŸŽ“ à¦šà¦²à¦®à¦¾à¦¨ à¦•à§‹à¦°à§�à¦¸ à¦¸à§�à¦ªà§‡à¦¸', icon: GraduationCap },
                    { id: 'routines', label: 'ðŸ“… à¦�à¦•à¦¾à¦¡à§‡à¦®à¦¿à¦• à¦°à§�à¦Ÿà¦¿à¦¨', icon: Calendar },
                    { id: 'profile', label: 'ðŸ‘¤ à¦ªà§�à¦°à§‹à¦«à¦¾à¦‡à¦² à¦“ à¦¸à§‡à¦Ÿà¦¿à¦‚à¦¸', icon: UserIcon },
