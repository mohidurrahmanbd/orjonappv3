  // Guest Limitation Guard & Helpers
  const checkGuestAccess = (featureName: string = 'à¦�à¦‡ à¦«à¦¿à¦šà¦¾à¦°à¦Ÿà¦¿'): boolean => {
    if (user.isGuest) {
      showCustomAlert(
        `ðŸ”’ à¦°à§‡à¦œà¦¿à¦¸à§�à¦Ÿà§�à¦°à§‡à¦¶à¦¨ à¦ªà§�à¦°à§Ÿà§‹à¦œà¦¨!\n\nà¦—à§‡à¦¸à§�à¦Ÿ (Guest) à¦¹à¦¿à¦¸à§‡à¦¬à§‡ à¦•à§�à¦¯à¦¾à¦Ÿà¦¾à¦—à¦°à¦¿ à¦“ à¦¸à¦¾à¦¬-à¦•à§�à¦¯à¦¾à¦Ÿà¦¾à¦—à¦°à¦¿ à¦¦à§‡à¦–à¦¾ à¦—à§‡à¦²à§‡à¦“ MCQ à¦ªà§œà¦¾ à¦“ à¦ªà¦°à§€à¦•à§�à¦·à¦¾ à¦¦à§‡à¦“à§Ÿà¦¾à¦° à¦œà¦¨à§�à¦¯ à¦¬à¦¿à¦¨à¦¾à¦®à§‚à¦²à§�à¦¯à§‡ à¦…à§�à¦¯à¦¾à¦•à¦¾à¦‰à¦¨à§�à¦Ÿ à¦°à§‡à¦œà¦¿à¦¸à§�à¦Ÿà§�à¦°à§‡à¦¶à¦¨ à¦¸à¦®à§�à¦ªà¦¨à§�à¦¨ à¦•à¦°à§�à¦¨à¥¤\n\n${featureName} à¦…à§�à¦¯à¦¾à¦•à§�à¦¸à§‡à¦¸ à¦•à¦°à¦¤à§‡ à¦°à§‡à¦œà¦¿à¦¸à§�à¦Ÿà§�à¦°à§‡à¦¶à¦¨ à¦•à¦°à§�à¦¨à¥¤`,
        () => {
          if (onRegisterPrompt) onRegisterPrompt();
        },
        'ðŸ”’ à¦°à§‡à¦œà¦¿à¦¸à§�à¦Ÿà§�à¦°à§‡à¦¶à¦¨ à¦ªà§�à¦°à§Ÿà§‹à¦œà¦¨',
        true,
        'à¦°à§‡à¦œà¦¿à¦¸à§�à¦Ÿà§�à¦°à§‡à¦¶à¦¨ à¦•à¦°à§�à¦¨',
        'à¦�à¦–à¦¨ à¦¨à§Ÿ'
      );
      return false;
    }
    return true;
  };

  const handleTabSelect = (tab: 'dashboard' | 'recentJob' | 'preparation' | 'job' | 'yearJob' | 'bookmarks' | 'exams' | 'results' | 'courses' | 'routines' | 'profile' | 'currentAffairs') => {
    if (user.isGuest && (tab === 'bookmarks' || tab === 'routines')) {
      checkGuestAccess(
        tab === 'bookmarks' ? 'à¦¸à§‡à¦­à¦•à§ƒà¦¤ à¦¬à§�à¦•à¦®à¦¾à¦°à§�à¦•à¦¸' : 'à¦�à¦•à¦¾à¦¡à§‡à¦®à¦¿à¦• à¦°à§�à¦Ÿà¦¿à¦¨'
      );
      return;
    }
    if (tab === 'recentJob') {
      setSelectedRecentJobMonth(null);
      setRecentExamSearchQuery('');
    }
    if (tab === 'courses') {
      setSelectedCourseFilter(enrolledCourseIds.length > 0 ? 'enrolled' : 'all');
    }
    if (tab === 'routines') {
      setSelectedRoutineCourseId(null);
      setSelectedRoutineItem(null);
    }
    setActiveTab(tab);
  };

  const renderGuestLockCard = (title: string, description: string) => (
