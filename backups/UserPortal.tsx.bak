// Helper to detect variations/typos of "à¦œà¦¬ à¦¸à¦²à¦¿à¦‰à¦¶à¦¨ à¦ªà¦°à§€à¦•à§�à¦·à¦¾"
const isJobSolutionVariation = (name: string): boolean => {
  if (!name) return false;
  const normalized = name.trim().toLowerCase();
  return (
    normalized === 'à¦œà¦¬ à¦¸à¦²à¦¿à¦‰à¦¶à¦¨ à¦ªà¦°à§€à¦•à§�à¦·à¦¾' ||
    normalized === 'à¦œà¦¬ à¦¸à¦²à¦‰à¦¶à¦¨ à¦ªà¦°à¦¿à¦•à§�à¦·à¦¾' ||
    normalized === 'à¦œà¦¬ à¦¸à¦²à¦‰à¦¶à¦¨ à¦ªà¦°à§€à¦•à§�à¦·à¦¾' ||
    normalized === 'à¦œà¦¬ à¦¸à¦²à¦¿à¦‰à¦¶à¦¨ à¦¬à§�à¦¯à¦¾à¦‚à¦•' ||
    normalized === 'à¦œà¦¬ à¦¸à¦²à¦‰à¦¶à¦¨ à¦¬à§�à¦¯à¦¾à¦‚à¦•' ||
    normalized === 'à¦œà¦¬ à¦¸à¦²à¦¿à¦‰à¦¶à¦¨ à¦¬à§�à¦¯à¦¾à¦™à§�à¦•' ||
    normalized === 'à¦œà¦¬ à¦¸ãƒªãƒ¥ãƒ¼ã‚·ãƒ§ãƒ³ à¦¬à§�à¦¯à¦¾à¦‚à¦•' ||
    normalized === 'job solution' ||
    normalized === 'job solutions' ||
    normalized === 'job solution bank' ||
    normalized === 'à¦œà¦¬ à¦¸à¦²à¦¿à¦‰à¦¶à¦¨' ||
    normalized === 'à¦œà¦¬ à¦¸à¦²à¦‰à¦¶à¦¨' ||
    normalized === 'à¦œà¦¬ à¦¸ãƒªãƒ¥ãƒ¼ã‚·ãƒ§ãƒ³'
  );
};

